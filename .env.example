# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BOOTSTRAP_SECRET: Optional secret token used during the one-time owner account bootstrap.
# When set in Cloudflare Workers environment variables or .dev.vars, the initial owner creation
# requires this secret. Once the first owner account is registered, bootstrap is permanently disabled.
BOOTSTRAP_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET"
